{
  // Cloudflare config: serve the built configurator as a static site.
  // The Cloudflare build runs `npm run build` inside configurator/, which
  // produces configurator/dist; this deploys that folder as static assets.
  "name": "stormsafe-kit",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./configurator/dist"
  }
}
